# Copy to .env. The DATABASE_URL below is for Docker Compose; use localhost
# instead of db when running the app directly on your machine.
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://seo:seo@db:5432/seo_intelligence

# Generate with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

PUBLIC_API_URL=http://127.0.0.1:8000
OPERATOR_REDIRECT_URL=http://127.0.0.1:8000/api/v1/integrations/google/status
CORS_ORIGINS=["http://127.0.0.1:5173"]

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback

CRAWLER_USER_AGENT=SEOGrowthIntelligenceBot/0.1 (+private; local crawler)
CRAWLER_MAX_PAGES_LIMIT=5000
CRAWLER_MAX_DEPTH_LIMIT=10
CRAWLER_MAX_CONCURRENCY_LIMIT=8
CRAWLER_MIN_REQUEST_DELAY_MS=250
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_MAX_REDIRECTS=5
CRAWLER_DEFAULT_MAX_PAGES=500
CRAWLER_DEFAULT_MAX_DEPTH=5
CRAWLER_DEFAULT_CONCURRENCY=4
CRAWLER_DEFAULT_REQUEST_DELAY_MS=500
CRAWLER_DEFAULT_TIMEOUT_S=15
CRAWLER_ALLOW_PRIVATE_NETWORKS=false

# Optional competitor crawl and SEO data provider settings.
COMPETITOR_MAX_PAGES=300
COMPETITOR_MIN_REQUEST_DELAY_MS=1000
COMPETITOR_MAX_CONCURRENCY=2
SEO_DATA_PROVIDER=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

WORKER_POLL_INTERVAL_S=2
WORKER_STALE_AFTER_S=300
GSC_INITIAL_DAYS=90
GA4_INITIAL_DAYS=90
